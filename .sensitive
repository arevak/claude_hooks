# .sensitive - Define patterns for files that should be blocked by Claude Code hooks
# This file uses full gitignore-style glob patterns with advanced features
# Lines starting with # are comments and will be ignored

# ============================================================================
# TERRAFORM SENSITIVE FILES
# ============================================================================
# Block all tfvars files (terraform variables)
*.tfvars
*.tfvars.json

# Allow example files (negation pattern)
!example.tfvars
!example.tfvars.json

# Block all production environments (globstar pattern)
**/environments/prod/**
**/environments/production/**

# But allow README files in production environments
!**/environments/prod/README.md
!**/environments/production/README.md

# ============================================================================
# ENVIRONMENT FILES
# ============================================================================
# Block all environment files
.env*
*.env

# Allow example and template files
!.env.example
!.env.template
!.env.sample

# ============================================================================
# SECRET & CONFIGURATION FILES
# ============================================================================
# Block secrets at any depth (globstar)
**/secrets.json
**/secrets.yaml
**/secrets.yml

# Block production config files at root only (root-relative)
/config/production.*
/config/prod.*

# Block nested production configs anywhere
**/config/**/production.*
**/config/**/prod.*

# ============================================================================
# SSH & CRYPTOGRAPHIC KEYS
# ============================================================================
# Block all key files anywhere in project
**/*.pem
**/*.key
**/*.p12
**/*.pfx

# Specific SSH key files
**/id_rsa
**/id_dsa
**/id_ecdsa
**/id_ed25519
**/.ssh/*.key

# ============================================================================
# DATABASE CONNECTION FILES
# ============================================================================
**/.pgpass
**/my.cnf
**/.my.cnf
**/database.yml
**/database.yaml

# ============================================================================
# CLOUD PROVIDER CREDENTIALS
# ============================================================================
# AWS credentials
**/.aws/credentials
**/.aws/config

# Google Cloud
**/gcloud/credentials.json
**/.gcloud/**/*.json

# Azure
**/.azure/credentials
**/.azure/**/*.pem

# ============================================================================
# API KEYS & TOKENS
# ============================================================================
# Match files with sensitive keywords (case-insensitive)
**/*api-key*
**/*api_key*
**/*apikey*
**/*token*
**/*secret*
**/*password*
**/*credential*

# Allow documentation and examples
!**/*example*
!**/*sample*
!**/*template*
!**/*README*

# ============================================================================
# CERTIFICATES & KEYSTORES
# ============================================================================
**/*.keystore
**/*.jks
**/*.pkcs12
**/truststore.*

# ============================================================================
# MISCELLANEOUS SENSITIVE FILES
# ============================================================================
# Docker secrets
**/secrets/**
!**/secrets/README.md

# Kubernetes secrets
**/k8s/**/secrets/**
**/kubernetes/**/secrets/**

# CI/CD secrets
**/.gitlab-ci-secrets.yml
**/.github/secrets/**